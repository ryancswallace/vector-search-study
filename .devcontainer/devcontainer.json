{
    "name": "vector-search-study-dev",
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--platform=linux/amd64"
        ],
        "args": {
            "DEBIAN_VERSION": "bookworm",
            "PYTHON_VERSION": "3.12",
            "UV_VERSION": "0.11.23"
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "moby": true,
            "installDockerBuildx": true,
            "dockerDashComposeVersion": "none",
            "installDockerComposeSwitch": false
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24"
        }
    },
    "mounts": [
        "source=vector-search-study-dev-venv,target=${containerWorkspaceFolder}/.venv,type=volume"
    ],
    "containerEnv": {
        "LOKY_MAX_CPU_COUNT": "1",
        "MKL_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
        "OPENBLAS_NUM_THREADS": "1",
        "PIP_DISABLE_PIP_VERSION_CHECK": "1",
        "PYTHONHASHSEED": "0",
        "UV_LINK_MODE": "copy",
        "UV_PROJECT_ENVIRONMENT": ".venv",
        "VECLIB_MAXIMUM_THREADS": "1"
    },
    "customizations": {
        "codespaces": {
            "openFiles": [
                "README.md",
                "docs/project/development.md"
            ]
        },
        "vscode": {
            "settings": {
                "editor.codeActionsOnSave": {
                    "source.fixAll.ruff": "explicit",
                    "source.organizeImports.ruff": "explicit"
                },
                "editor.formatOnSave": true,
                "files.eol": "\n",
                "files.insertFinalNewline": true,
                "python.analysis.typeCheckingMode": "standard",
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.testing.pytestArgs": [
                    "tests"
                ],
                "python.testing.pytestEnabled": true,
                "python.testing.unittestEnabled": false,
                "ruff.nativeServer": "on",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                }
            },
            "extensions": [
                "charliermarsh.ruff",
                "davidanson.vscode-markdownlint",
                "detachhead.basedpyright",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "mikestead.dotenv",
                "ms-azuretools.vscode-containers",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-vscode.makefile-tools",
                "redhat.vscode-yaml",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "vivaxy.vscode-conventional-commits"
            ]
        }
    },
    "postCreateCommand": "sudo chown -R vscode:vscode .venv && make devcontainer-ready",
    "runArgs": [
        "--platform=linux/amd64"
    ],
    "remoteUser": "vscode"
}
